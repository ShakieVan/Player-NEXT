<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal">
        <shape android:shape="rectangle">
            <size android:height="6dp" />
            <solid android:color="#0E0E11" />
            <stroke android:width="1dp" android:color="#2A2A2D" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <size android:height="6dp" />
                <gradient android:angle="0" android:startColor="?attr/pnAccentStrong" android:endColor="?attr/pnAccent" />
                <corners android:radius="3dp" />
            </shape>
        </scale>
    </item>
</layer-list>
