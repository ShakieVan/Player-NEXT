<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="22dp" android:height="22dp" />
            <gradient android:type="radial" android:gradientRadius="11dp" android:startColor="#88FF9A5C" android:endColor="#00FF7A3D" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#F2F2F2" />
            <stroke android:width="2dp" android:color="?attr/pnAccent" />
        </shape>
    </item>
</layer-list>
