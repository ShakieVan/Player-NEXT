<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NowPlayingAction">
        <item name="android:background">@drawable/round_ripple</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="NowPlayingActionIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="tint">@color/pn_on_surface</item>
    </style>

    <style name="NowPlayingActionText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textColor">@color/pn_on_surface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="EqLabel">
        <item name="android:textColor">@color/pn_on_surface_dim</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
